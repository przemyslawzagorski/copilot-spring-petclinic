# ==========================================================================
# DevKit MCP - konfiguracja. Skopiuj do `.env` w TYM katalogu i uzupelnij.
# Wszystkie klucze sa OPCJONALNE - serwer startuje bez nich i degraduje sie
# kontrolowanie. Stan sprawdzisz w resource `devkit://status`.
# ==========================================================================

# --- Research w sieci ---
# Tavily: wyszukiwarka zbudowana pod agentow AI, 1000 zapytan/mies. za darmo.
# https://app.tavily.com  -> bez niej web_search schodzi na DuckDuckGo (gorsze snippety)
TAVILY_API_KEY=

# Jina AI: r.jina.ai (URL -> Markdown) dziala BEZ klucza, ale z niskim limitem i cache.
# Klucz podnosi limity oraz odblokowuje s.jina.ai i embeddingi jina-embeddings-v3.
# https://jina.ai/api-dashboard  (10 mln tokenow na start)
JINA_API_KEY=

# --- Delegowanie podzadan do szybkiego modelu ---
# Groq: setki tokenow/s. Bez klucza `delegate` jest wylaczone, a `deep_research`
# i `ask_repo` zwracaja surowe fragmenty zamiast syntezy.
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# szybsza/tansza alternatywa: llama-3.1-8b-instant

# --- Modele specjalistyczne (opcjonalne: OCR, ASR, klasyfikacja) ---
# https://huggingface.co/settings/tokens
HF_API_KEY=

# --- Pamiec wektorowa ---
# Puste QDRANT_URL = tryb lokalny (embedded) w katalogu ponizej. Zero konfiguracji.
# Darmowy klaster: https://cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=
# QDRANT_PATH=./.qdrant_local
# DEVKIT_COLLECTION_PREFIX=devkit

# --- Embeddingi: auto | fastembed | jina | hash ---
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Dla materialow po polsku rozwaz: intfloat/multilingual-e5-small

# --- Limity i bezpieczenstwo ---
# DEVKIT_HTTP_TIMEOUT=30
# DEVKIT_MAX_PAGE_CHARS=8000
# DEVKIT_ALLOW_PRIVATE_URLS=false   # true = pozwol czytac localhost (np. lokalny Swagger)
# DEVKIT_REPO_ROOT=                 # nadpisz, jesli autodetekcja korzenia repo zawiedzie
